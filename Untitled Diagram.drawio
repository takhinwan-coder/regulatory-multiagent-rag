        <mxCell id="pMj7Xkz5I8tPxx53g8yt-78" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;(decesion needed)&lt;/div&gt;1. Vector DB?&lt;div&gt;- best for multi vector&lt;br&gt;&lt;div&gt;2. Vector Index?&lt;/div&gt;&lt;div&gt;- extract similar vector index&lt;/div&gt;&lt;div&gt;3. Keyword Search?&lt;/div&gt;&lt;div&gt;- exact match needed&lt;/div&gt;&lt;div&gt;4. No Retrieval? (put all into context window)&lt;/div&gt;&lt;div&gt;- best for easy task - -ve lower accuracy/higher token/ likely hallucination&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;REF: https://www.youtube.com/watch?v=rXFV1ivDe6c&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="260" x="450" y="840" as="geometry" />
        </mxCell>
        <mxCell id="pMj7Xkz5I8tPxx53g8yt-79" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;" value="&lt;h1 style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Coordinate Agent&lt;/span&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="252.19" width="260" x="1357.5" y="28.909999999999997" as="geometry" />
        </mxCell>
        <mxCell id="pMj7Xkz5I8tPxx53g8yt-81" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="Multi-agent consideation:&lt;br&gt;1. Single agent with many tools: one agent decides everything in one main context.&amp;nbsp;&lt;div&gt;2. Single agent with sub-prompts: separate LLM calls, but centrally controlled and not necessarily agents.&amp;nbsp;&lt;/div&gt;&lt;div&gt;3. Multi-agent: multiple role/state-bearing components can decide, act, exchange outputs, and sometimes challenge or delegate to one another.&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="767.5" x="850" y="100" as="geometry" />
        </mxCell>
        <mxCell id="pMj7Xkz5I8tPxx53g8yt-82" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="Specialised the SOP/protocol for LLM to read and follow.&lt;br&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="260" x="105" y="840" as="geometry" />
        </mxCell>
        <mxCell id="pMj7Xkz5I8tPxx53g8yt-83" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;&lt;div&gt;short-term memory the LLM store (agent&#39;s learning?)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="260" x="785" y="850" as="geometry" />
        </mxCell>
        <mxCell id="pMj7Xkz5I8tPxx53g8yt-84" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="External vs Internal Servers to be called by the LLM" vertex="1">
          <mxGeometry height="130" width="570" x="120" y="100" as="geometry" />
        </mxCell>
        <mxCell id="pMj7Xkz5I8tPxx53g8yt-85" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table class=&quot;w-full divide-y divide-border&quot;&gt;&lt;thead class=&quot;bg-muted/80&quot;&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot;&gt;Component&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; style=&quot;text-align: right;&quot;&gt;Separate agent needed?&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot;&gt;Recommendation&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody class=&quot;divide-y divide-border&quot;&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Task classification&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot; style=&quot;text-align: right;&quot;&gt;Usually no&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Rules or a small LLM call&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Skill selection&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot; style=&quot;text-align: right;&quot;&gt;Usually no&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Metadata-based routing, possibly assisted by an LLM&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;RAG retrieval&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot; style=&quot;text-align: right;&quot;&gt;No&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Retrieval service with access controls&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Memory retrieval&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot; style=&quot;text-align: right;&quot;&gt;No&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Dedicated memory service and filtering&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Planning and execution&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot; style=&quot;text-align: right;&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;Yes, one main agent&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Primary worker with dynamically exposed tools&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Tool execution&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot; style=&quot;text-align: right;&quot;&gt;No&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;MCP servers or ordinary tool services&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Output review&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot; style=&quot;text-align: right;&quot;&gt;Sometimes&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Separate reviewer for important or complex work&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Metrics and tracing&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot; style=&quot;text-align: right;&quot;&gt;No&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Observability infrastructure&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Prompt/tool improvement&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot; style=&quot;text-align: right;&quot;&gt;No runtime agent required&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Offline evaluation and governed deployment&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="280" width="560" x="1085" y="-290" as="geometry" />
        </mxCell>
